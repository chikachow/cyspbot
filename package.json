{
  "name": "cyspbot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --run lockfile:check && node --run format:check && node --run env-types:check && node --run lint && node --run typecheck && node --run knip && node --run test && node --run deploy:dry-run",
    "deploy:dry-run": "pnpm --recursive --filter './workers/*' run deploy:dry-run",
    "dev": "WRANGLER_LOG=none WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_REGISTRY_PATH=.wrangler/registry wrangler dev --config workers/cyspbot-token-exchange/wrangler.jsonc --config workers/cyspbot-github-webhook-receiver/wrangler.jsonc --env-file .dev.vars",
    "env-types:check": "pnpm --recursive --filter './workers/*' run env-types:check",
    "env-types:generate": "pnpm --recursive --filter './workers/*' run env-types:generate",
    "format": "oxfmt . '!workers/**/src/*.generated.d.ts'",
    "format:check": "oxfmt --check . '!workers/**/src/*.generated.d.ts'",
    "lint": "node --run runtime-types:generate && oxlint --type-aware --report-unused-disable-directives --deny-warnings --ignore-pattern 'workers/**/src/*.generated.d.ts' .",
    "lint:fix": "node --run runtime-types:generate && oxlint --type-aware --fix --ignore-pattern 'workers/**/src/*.generated.d.ts' .",
    "lockfile:check": "pnpm install --lockfile-only --frozen-lockfile",
    "knip": "knip --no-progress",
    "runtime-types:generate": "pnpm --recursive --filter './workers/*' run runtime-types:generate",
    "test": "WRANGLER_LOG=none WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_REGISTRY_PATH=.wrangler/registry vitest run",
    "test:coverage": "WRANGLER_LOG=none WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_REGISTRY_PATH=.wrangler/registry vitest run --coverage",
    "typecheck": "node --run typecheck:packages && pnpm --recursive --filter './workers/*' run typecheck && node --run typecheck:test",
    "typecheck:packages": "tsc --project tsconfig.packages.json",
    "typecheck:test": "tsc --project tsconfig.json",
    "wrangler:whoami": "WRANGLER_LOG=none WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_REGISTRY_PATH=.wrangler/registry wrangler whoami"
  },
  "dependencies": {
    "jose": "6.2.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260724.1",
    "@cyspbot/github-webhook-receiver": "workspace:*",
    "@cyspbot/http": "workspace:*",
    "@cyspbot/oidc": "workspace:*",
    "@cyspbot/oidc-issuer-fly": "workspace:*",
    "@cyspbot/oidc-issuer-github-actions": "workspace:*",
    "@cyspbot/oidc-issuer-google-service-account": "workspace:*",
    "@cyspbot/token-exchange": "workspace:*",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@vitest/coverage-istanbul": "4.1.9",
    "knip": "6.29.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.9",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.33.0"
}
