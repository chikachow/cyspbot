{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyspbot-test-harness",
  "main": "test/support/root-test-harness.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "no_nodejs_als",
    "disallow_eval_during_startup",
    "global_fetch_strictly_public",
  ],
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": ["GITHUB_WEBHOOK_SECRET"],
  },
  "vars": {
    "GITHUB_APP_ID": "000000",
  },
}
