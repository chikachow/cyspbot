{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cyspbot-token-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "no_nodejs_als",
    "disallow_eval_during_startup",
    "global_fetch_strictly_public",
  ],
  "vars": {
    "TOKEN_PROXY_ENDPOINT": "https://broker.example/github/apps/example-app/token",
  },
  "observability": {
    "enabled": true,
  },
}
